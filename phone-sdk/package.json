{
  "name": "@ink-zenly/phone-sdk",
  "version": "0.4.6",
  "description": "LetsGal 自定义手机扩展 SDK：宿主 PhoneExtension / ToastExtension，以及内页 registerPhoneApp 插件 API",
  "author": "池水三两升",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./plugin": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "@avg-studio/sdk": "*"
  },
  "keywords": [
    "letsgal",
    "phone",
    "sdk",
    "avg-studio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ink-zenly/ext-7a9373.git",
    "directory": "phone-sdk"
  }
}
